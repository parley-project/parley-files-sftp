<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<!-- License, developer, SCM, URL, Java level and the Maven Central release profile
	     all come from parley-parent. -->
	<parent>
		<groupId>us.bringardner.parley</groupId>
		<artifactId>parley-parent</artifactId>
		<version>1.0.0-SNAPSHOT</version>
		<relativePath>../parley-parent/pom.xml</relativePath>
	</parent>

	<artifactId>parley-files-sftp</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<name>Parley Files SFTP</name>
	<description>A parley-files FileSource implementation for SSH/SFTP servers, using JSch (default),
		Apache MINA SSHD or parley-ssh, chosen at run time. Found at runtime through ServiceLoader.
		Formerly us.bringardner:bjl_file_system_sftp.</description>

	<properties>
		<!-- Written to the jar manifest as Automatic-Module-Name -->
		<parley.moduleName>us.bringardner.parley.files.sftp</parley.moduleName>
	</properties>


	<!-- GitHub Packages, used by release.sh. Maven Central releases use: mvn -Prelease clean deploy -->
	<distributionManagement>
		<repository>
			<id>github</id>
			<name>tony-bringardner</name>
			<url>https://maven.pkg.github.com/tony-bringardner/parley-files-sftp</url>
		</repository>
	</distributionManagement>


	<dependencies>
		<dependency>
			<!-- Parley's own SSH library, the "parley" implementation (was bjl_net_ssh) -->
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-ssh</artifactId>
			<version>1.0.0-SNAPSHOT</version>
		</dependency>
		<!-- Used directly (Hex), so named here too -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-core</artifactId>
			<version>1.0.0-SNAPSHOT</version>
		</dependency>
		<!-- Used directly (IoUtils), so named here too -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-io</artifactId>
			<version>1.0.0-SNAPSHOT</version>
		</dependency>
		
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-files</artifactId>
			<version>1.0.0-SNAPSHOT</version>
		</dependency>
		<!-- The shared FileSource test suite -->
		<dependency>
			<groupId>us.bringardner.parley</groupId>
			<artifactId>parley-files</artifactId>
			<version>1.0.0-SNAPSHOT</version>
			<type>test-jar</type>
			<scope>test</scope>
		</dependency>
		
		<!-- SSH libraries. Both are included; which one is used is chosen at run
		     time with the "implementation" connection property or the system
		     property parley.sftp.implementation ("jsch", the default, "mina" or "parley"). -->

		<!-- Maintained JSch fork: modern key types and algorithms; same com.jcraft.jsch packages -->
		<dependency>
			<groupId>com.github.mwiede</groupId>
			<artifactId>jsch</artifactId>
			<version>2.28.7</version>
		</dependency>

		<!-- Apache MINA SSHD client and SFTP (sshd-core and sshd-common come with it) -->
		<dependency>
			<groupId>org.apache.sshd</groupId>
			<artifactId>sshd-sftp</artifactId>
			<version>2.19.0</version>
		</dependency>
		<!-- Ed25519 keys for MINA SSHD; without it MINA can't read Ed25519 private
		     keys or known_hosts files that contain Ed25519 entries -->
		<dependency>
			<groupId>net.i2p.crypto</groupId>
			<artifactId>eddsa</artifactId>
			<version>0.3.0</version>
		</dependency>
<dependency>
    <groupId>org.junit.jupiter</groupId>
    <artifactId>junit-jupiter</artifactId>
    <version>5.13.4</version>
    <scope>test</scope>
</dependency>
<dependency>
    <groupId>junit</groupId>
    <artifactId>junit</artifactId>
    <version>4.13.2</version>
    <scope>test</scope>
</dependency>

		<!--
		https://mvnrepository.com/artifact/com.sshtools/maverick-synergy-server -->
		<dependency>
			<groupId>com.sshtools</groupId>
			<artifactId>maverick-synergy-server</artifactId>
			<version>3.1.2</version>
			<scope>test</scope>
		</dependency>

		<dependency>
			<groupId>com.sshtools</groupId>
			<artifactId>maverick-virtual-session</artifactId>
			<version>3.1.2</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.sshtools</groupId>
			<artifactId>maverick-virtual-filesystem</artifactId>
			<version>3.1.2</version>
			<scope>test</scope>
		</dependency>
