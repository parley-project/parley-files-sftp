<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
	child.project.url.inherit.append.path="false">
	<modelVersion>4.0.0</modelVersion>
	<!-- The parley-files-sftp modules: the FileSource factory with the SSH provider API, and the
	     providers. License, developer, Java level and the Maven Central release profile come from
	     parley-parent; the URLs below are this repository's, for every module. -->
	<parent>
		<groupId>us.bringardner.parley</groupId>
		<artifactId>parley-parent</artifactId>
		<version>1.0.0</version>
		<relativePath>../parley-parent/pom.xml</relativePath>
	</parent>

	<artifactId>parley-files-sftp-parent</artifactId>
	<version>1.0.0</version>
	<packaging>pom</packaging>
	<name>Parley Files SFTP (parent)</name>
	<description>The parley-files-sftp modules: an SFTP FileSource whose SSH library is a provider found
		on the class path (parley-ssh, JSch, Apache MINA SSHD or another).</description>
	<url>https://github.com/parley-project/parley-files-sftp</url>

	<scm child.scm.connection.inherit.append.path="false"
		child.scm.developerConnection.inherit.append.path="false"
		child.scm.url.inherit.append.path="false">
		<connection>scm:git:https://github.com/parley-project/parley-files-sftp.git</connection>
		<developerConnection>scm:git:ssh://git@github.com/parley-project/parley-files-sftp.git</developerConnection>
		<url>https://github.com/parley-project/parley-files-sftp/tree/master</url>
		<tag>HEAD</tag>
	</scm>

	<issueManagement>
		<system>GitHub</system>
		<url>https://github.com/parley-project/parley-files-sftp/issues</url>
	</issueManagement>

	<modules>
		<module>parley-files-sftp</module>
		<module>parley-files-sftp-parley</module>
		<module>parley-files-sftp-jsch</module>
		<module>parley-files-sftp-mina</module>
		<module>parley-files-sftp-tests</module>
	</modules>

	<properties>
		<parley.version>1.0.0</parley.version>
	</properties>

	<!-- GitHub Packages. Maven Central releases use: mvn -Prelease clean deploy -->
	<distributionManagement>
		<repository>
			<id>github</id>
			<name>parley-project</name>
			<url>https://maven.pkg.github.com/parley-project/parley-files-sftp</url>
		</repository>
	</distributionManagement>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.sonatype.central</groupId>
					<artifactId>central-publishing-maven-plugin</artifactId>
					<configuration>
						<!-- the cross-provider tests aren't published -->
						<excludeArtifacts>
							<excludeArtifact>parley-files-sftp-tests</excludeArtifact>
						</excludeArtifacts>
					</configuration>
				</plugin>
			</plugins>
		</pluginManagement>
		<plugins>
			<!-- Attaches each module's -sources.jar. The version comes from parley-parent; package
			     (not deploy) so the source jar is attached BEFORE the deploy plugin runs. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-source-plugin</artifactId>
				<executions>
					<execution>
						<id>attach-sources</id>
						<phase>package</phase>
						<goals>
							<goal>jar-no-fork</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
